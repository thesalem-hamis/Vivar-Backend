generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password_hash String
  name          String?
  googleId      String    @unique
  avatarUrl     String?
  lastLogin     DateTime  @default(now())
  createdAt     DateTime  @default(now())
}

model Property {
  id               String   @id @default(uuid())
  title            String
  description      String?  @db.Text
  propertyType     PropertyType
  propertySubType  PropertySubType
  pricing          PricingAndFees?
  purpose          Purpose  @default(FOR_SALE)
  bedrooms         Int?
  bathrooms        Int?
  floorAreaSqm     Decimal? @db.Decimal(10, 2)
  isVerified       Boolean  @default(true)
  amenities        Amenities?
  furnishingStatus FurnishingStatus?
  condition        Condition?
  location         Location?
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  viewsCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Amenities {
  id              String        @id @default(uuid())
  propertyId      String        @unique
  isServiced      Boolean       @default(false)
  hasBq           Boolean       @default(false)
  powerSupply     PowerSupply?
  amenityList     AmenityType[] 
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model PricingAndFees {
  id                  String        @id @default(uuid())
  propertyId          String        @unique
  currency            Currency      @default(NGN)
  price               Decimal       @db.Decimal(15, 2)
  paymentPeriod       PaymentPeriod
  serviceCharge       Decimal?      @default(0) @db.Decimal(12, 2)
  agencyFeePercentage Decimal?      @default(0) @db.Decimal(5, 2)
  legalFeePercentage  Decimal?      @default(0) @db.Decimal(5, 2)
  cautionFee          Decimal?      @default(0) @db.Decimal(12, 2)
  property            Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Location {
  id              String   @id @default(uuid())
  propertyId      String   @unique
  state           String
  lga             String
  localityArea    String
  estateName      String?
  streetAddress   String?
  latitude        Float?
  longitude       Float?
  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model ProjectAddress {
  id          String    @id @default(uuid())
  project_id  String   @unique
  Project     Project   @relation(fields: [project_id], references: [id])
  street      String
  city        String
  state       String
  zip_code    String?
  country     String
}

model Lead {
  id               String   @id @default(uuid())
  fullName         String
  email            String   @unique
  phone            String
  leadType         String 
  budgetRange      String?
  timeline         String?
  notes            String?
  status           SubscriptionStatus @default(SUBSCRIBED)
  subscribedAt     DateTime           @default(now())
  unsubscribedAt   DateTime?
  segment          String?
  source           String? 
  
  @@index([email])
  createdAt     DateTime @default(now())
}

model Insight {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  category      String
  content       String
  excerpt       String
  publishedAt   DateTime @default(now())
  targetKeyword String?
}

model Project {
  id              String   @id @default(uuid())
  title           String
  developerName   String?
  description     String
  status          ProjectStatus @default(COMING_SOON)
  priceFrom       Decimal
  unitCount       Int?
  bedroomRange    String?
  completionDate  DateTime?
  location        String
  landmark        String?
  isVetted        Boolean  @default(true)
  isLegallyVetted Boolean  @default(true)
  address         ProjectAddress?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Consultation {
  id            String   @id @default(uuid())
  fullName      String
  email         String
  phone         String
  location      String
  interestType  String
  targetArea    String
  budgetRange   String
  timeline      String 
  notes         String?
  status        ConsultationStatus @default(NEW)
  reviewedAt    DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum ConsultationStatus {
  NEW
  REVIEWED
  CONTACTED
  CONVERTED
  ARCHIVED
}

enum SubscriptionStatus {
  SUBSCRIBED
  UNSUBSCRIBED
  BOUNCED
}

enum ProjectStatus {
  COMING_SOON
  SELLING_NOW
  UNDER_CONSTRUCTION
  COMPLETED
}

enum Purpose {
  FOR_RENT
  FOR_SALE
  SHORT_LET
  JOINT_VENTURE
}

enum PropertyType {
  HOUSE
  FLAT_APARTMENT
  COMMERCIAL
  LAND
  EVENT_CENTRE
}

enum PropertySubType {
  // Houses
  DETACHED_DUPLEX
  SEMI_DETACHED_DUPLEX
  TERRACED_DUPLEX
  BUNGALOW
  MANSION
  // Flats
  MINI_FLAT
  SELF_CONTAIN
  PENTHOUSE
  MAISONETTE
  STUDIO
  // Commercial
  OFFICE_SPACE
  SHOP
  WAREHOUSE
  PLAZA
  FILLING_STATION
}

enum Currency {
  NGN
  USD
}

enum PaymentPeriod {
  PER_ANNUM
  PER_MONTH
  PER_NIGHT
  OUTRIGHT
}

enum LandTitle {
  C_OF_O
  GOVERNORS_CONSENT
  DEED_OF_ASSIGNMENT
  EXCISION
  GAZETTE
  FAMILY_RECEIPT
  FREEHOLD
}

enum FurnishingStatus {
  FURNISHED
  SEMI_FURNISHED
  UNFURNISHED
}

enum Condition {
  BRAND_NEW
  NEWLY_BUILT
  RENOVATED
  FAIR_CONDITION
}

enum PowerSupply {
  TWENTY_FOUR_HOURS
  TWELVE_HOURS
  SOLAR_INVERTER
  PUBLIC_POWER_ONLY
}

enum AmenityType {
  WATER_TREATMENT_PLANT
  SWIMMING_POOL
  GATED_ESTATE
  UNIFORMED_SECURITY
  FITTED_KITCHEN
  CCTV
  AMPLE_PARKING
}